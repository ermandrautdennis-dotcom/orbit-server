# ── Copy to .env for local dev. On Railway set these under Variables. ──

# Public URL of your deployment (used in the loader snippet).
BASE_URL=https://your-app.up.railway.app

# ── Secrets — CHANGE ALL OF THESE ──
# Mixed into key hashing. Long random string.
KEY_PEPPER=change-me-to-a-long-random-string
# Signs script responses so the loader can verify authenticity.
LOADER_SECRET=change-me-too
# Bearer token for the /admin HTTP API.
ADMIN_TOKEN=change-me-admin

# ── Database ──
# Leave DATABASE_URL empty to use SQLite. On Railway, add the Postgres plugin
# and it will inject DATABASE_URL automatically (recommended for persistence).
# DATABASE_URL=postgresql://user:pass@host:5432/db
# If using SQLite, attach a Railway Volume and point this at it:
SQLITE_PATH=/data/orbit.db

# ── Discord ──
DISCORD_TOKEN=your-bot-token
# Set to your server ID for instant slash-command sync (optional).
DISCORD_GUILD_ID=
# Role ID allowed to run admin commands. Empty = needs Administrator perm.
ADMIN_ROLE_ID=
# Channel ID for audit logs (key generation, redemptions). Optional.
LOG_CHANNEL_ID=

# ── Tuning (optional) ──
SCRIPTS_DIR=scripts
FREE_TIERS=public
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=30
