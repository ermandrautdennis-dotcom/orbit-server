# ──────────────────────────────────────────────────────────────────────────────
# Orbit Auth — environment configuration
# Copy to .env for local development. On Railway set these as service variables.
# Generate every secret with:  npm run secrets
# NEVER commit a filled-in .env.
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public HTTPS origin of the API (no trailing slash). This is the host the Lua
# loader talks to and the URL embedded in the snippet the bot hands out.
# In production this MUST be https://.
PUBLIC_BASE_URL=http://localhost:3000
# Set to true behind Railway / any reverse proxy so client IPs are read from
# X-Forwarded-For (one hop only). REQUIRED in production: without it every
# request appears to come from the proxy, which collapses all per-IP rate limits
# and all audit IP hashes onto one value. Leave false only when the app is
# directly exposed, as in local development.
TRUST_PROXY=false
# This API has no browser front end: the only user-facing panel is the Discord
# embed produced by /genpanel. Its clients are the Discord bot and the Lua
# loader, so no cross-origin browser access is granted and no CORS headers are
# emitted at all.

# ── Database (Railway injects DATABASE_URL automatically) ─────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit
# Require TLS to Postgres. Railway's internal network does not need it; set to
# true for external/managed Postgres over the public internet.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ── Cryptographic secrets (32+ bytes of base64url each, all distinct) ─────────
# Pepper used to derive the deterministic HMAC lookup hash for license keys.
# Rotating this invalidates every existing key. Back it up.
KEY_PEPPER=
# Pepper for hashing session / loader tokens at rest.
TOKEN_PEPPER=
# Pepper for hashing client IPs in audit logs (so logs hold no raw IPs).
IP_HASH_PEPPER=
# Secret shared between the Discord bot and the ADMIN API (key generation,
# whitelist/blacklist, the online/offline switch). Only the bot holds this.
ADMIN_API_SECRET=
# Secret for the bot's USER-facing calls (redeem, get script, status) made on
# behalf of a Discord user it has already authenticated. Deliberately separate:
# this credential cannot generate keys, blacklist anyone or touch the switch, so
# the surface the panel buttons drive carries far less authority than the admin
# surface.
BOT_API_SECRET=

# ── Discord application ───────────────────────────────────────────────────────
# Needed to register slash commands. No OAuth2 client secret is required: there
# is no login website, and the bot authenticates users via the interaction
# itself, which Discord has already signed.
DISCORD_CLIENT_ID=

# ── Discord bot ───────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# Guild the slash commands are registered to (guild-scoped = instant updates).
DISCORD_GUILD_ID=
# Comma separated role IDs allowed to run administrative commands.
DISCORD_ADMIN_ROLE_IDS=
# Comma separated Discord user IDs allowed to run administrative commands
# regardless of roles (break-glass owners).
DISCORD_OWNER_IDS=
# Base URL the bot uses to reach the API. Use the Railway internal URL when
# both run in the same project.
API_BASE_URL=http://localhost:3000

# ── Policy / tuning ───────────────────────────────────────────────────────────
# Lifetime of the session created when a user redeems through the Discord panel
# (seconds). 12h. A live session is required to fetch a loader, so revoking
# sessions forces users back through Discord without touching their licenses.
# Blacklisting revokes them immediately.
SESSION_TTL_SECONDS=43200
# Loader grant lifetime (seconds). Keep this very short.
GRANT_TTL_SECONDS=45
# Default license lifetime in days when the admin does not pass one. 0 = never.
DEFAULT_KEY_TTL_DAYS=30
# Hard cap for /genmasskey and POST /api/admin/keys/generate-mass.
MAX_MASS_KEYS=100
# Require a license to be whitelisted-user-bound before private hub access.
REQUIRE_WHITELIST_FOR_PRIVATE=true
# Max concurrent loader executions per license before it is flagged.
MAX_SESSIONS_PER_LICENSE=3
