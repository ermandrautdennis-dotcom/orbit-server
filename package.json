{
  "name": "orbit-auth",
  "version": "1.0.0",
  "private": true,
  "description": "Lua script authentication and licensing platform (API + Discord bot + panel + loader)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "start:bot": "node bot/index.js",
    "start:all": "node scripts/start-all.js",
    "dev": "node --watch backend/src/server.js",
    "migrate": "node database/migrate.js up",
    "migrate:status": "node database/migrate.js status",
    "seed:script": "node scripts/seed-script.js",
    "bot:register": "node bot/register-commands.js",
    "test": "node --test --test-concurrency=1 'tests/**/*.test.js'",
    "test:unit": "node --test 'tests/unit/*.test.js'",
    "test:integration": "node --test --test-concurrency=1 'tests/integration/*.test.js'",
    "secrets": "node scripts/generate-secrets.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@node-rs/argon2": "^2.0.2"
  }
}
